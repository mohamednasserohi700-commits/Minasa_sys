# ============================================
# ClientFlow Platform - Environment Variables
# ============================================

# Flask
FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-secret-key

# Database
# For local development (SQLite) - leave DATABASE_URL empty or unset
# For production on Railway (PostgreSQL) - Railway injects DATABASE_URL automatically
DATABASE_URL=sqlite:///clientflow.db

# Admin default account (created automatically on first run if not exists)
ADMIN_USERNAME=administrator
ADMIN_PASSWORD=3000330210
ADMIN_EMAIL=admin@clientflow.local

# File uploads
MAX_CONTENT_LENGTH_MB=25
UPLOAD_FOLDER=app/static/uploads

# Mail (optional - ready for future SMTP integration)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@clientflow.local

# Company / Project Manager info (shown on Estimation page & footer)
COMPANY_NAME=System Makers
PROJECT_MANAGER_NAME=Mohamed Naser
PROJECT_MANAGER_EMAIL=contact@clientflow.local
PROJECT_MANAGER_PHONE=+20 100 000 0000
